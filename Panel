local invisStore = {}
local function applyInvis(on)
    local char = LP.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
            if on then
                if invisStore[d] == nil then invisStore[d] = d.Transparency end
                d.Transparency = 1
            elseif invisStore[d] ~= nil then
                d.Transparency = invisStore[d]; invisStore[d] = nil
            end
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.NameDisplayDistance = on and 0 or 100
        hum.HealthDisplayDistance = on and 0 or 100
    end
end

