local ALL = {}        -- todos los remotes del juego
local learned = nil   -- { remote, args, score }
local replaying = false

local function collect()
    local out, seen = {}, {}
    local roots = { RS, RF, workspace }
    for _, plr in ipairs(Players:GetPlayers()) do
        local ps = plr:FindFirstChild("PlayerScripts")
        if ps then table.insert(roots, ps) end
    end
    for _, root in ipairs(roots) do
        local ok = pcall(function()
            for _, o in ipairs(root:GetDescendants()) do
                if (o:IsA("RemoteEvent") or o:IsA("RemoteFunction")) and not seen[o] then
                    seen[o] = true
                    table.insert(out, o)
                end
            end
        end)
    end
    ALL = out
    return #out
end

local function pathOf(o)
    local ok, p = pcall(function() return o:GetFullName() end)
    return ok and p or "?"
end

local function fire(remote, args)
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(unpackFn(args, 1, args.n or #args))
        elseif State.useFuncs then
            task.spawn(function() remote:InvokeServer(unpackFn(args, 1, args.n or #args)) end)
        end
    end)
end

