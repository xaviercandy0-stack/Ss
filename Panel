local enemyCd = {}

local function getEnemies()
    local list, seen = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                seen[plr.Character] = true
                table.insert(list, { char = plr.Character, hum = hum, root = root, player = plr })
            end
        end
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") and not seen[m] and m ~= LP.Character and not Players:GetPlayerFromCharacter(m) then
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if hum and root and hum.Health > 0 then
                table.insert(list, { char = m, hum = hum, root = root })
            end
        end
    end
    return list
end

local function canHit(e)
    local t = enemyCd[e.char]
    local cd = State.stealth and 0.28 or 0.14
    if t and os.clock() - t < cd then return false end
    enemyCd[e.char] = os.clock()
    return true
end

--=====================================================================
--  MAPEO DE ARGUMENTOS
--=====================================================================
local function mapArgs(src, enemy)
    local out = packFn()
    for i = 1, (src.n or #src) do
        local v = src[i]
        local t = typeof(v)
        if t == "Instance" then
            if v:IsA("Player") then
                out[i] = enemy.player or v
            elseif v:IsA("Humanoid") then
                out[i] = enemy.hum
            elseif v:IsA("BasePart") then
                out[i] = enemy.root
            elseif v:IsA("Model") then
                out[i] = enemy.char
            else
                out[i] = v
            end
        elseif t == "Vector3" then
            out[i] = enemy.root.Position
        elseif t == "CFrame" then
            out[i] = CFrame.new(enemy.root.Position)
        else
            out[i] = v
        end
    end
    return out
end

local function replayAt(enemy)
    if not learned then return end
    local args = mapArgs(learned.args, enemy)
    replaying = true
    fire(learned.remote, args)
    replaying = false
end

--=====================================================================
--  HOOK: APRENDE EL DISPARO REAL
--=====================================================================
local SHOTK = { "shoot", "fire", "attack", "hit", "bullet", "damage", "dmg" }

local function scoreArgs(args)
    local s = 0
    for i = 1, (args.n or #args) do
        local t = typeof(args[i])
        if t == "Instance" then s += 3
        elseif t == "Vector3" or t == "CFrame" then s += 2
        elseif t == "number" then s += 1 end
    end
    return s
end

local function installHook()
    if not hookmetamethod or not getrawmetatable then return end
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosureFn(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and not replaying
                and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                local n = self.Name:lower()
                for _, k in ipairs(SHOTK) do
                    if n:find(k, 1, true) then
                        local args = packFn(...)
                        local sc = scoreArgs(args)
                        if sc >= 2 and (not learned or sc > learned.score) then
                            learned = { remote = self, args = args, score = sc }
                            if toast then
                                toast("Disparo capturado · " .. self.Name)
                            end
                        end
                        break
                    end
                end
                if State.magic and learned and os.clock() - (lastShot or 0) > (State.stealth and 0.3 or 0.12) then
                    lastShot = os.clock()
                    task.spawn(function()
                        for _, e in ipairs(getEnemies()) do
                            if canHit(e) then replayAt(e) end
                        end
                    end)
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end
local lastShot = 0

