    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if bp and hum then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") then
                pcall(function() hum:EquipTool(c) end)
                return c
            end
        end
    end
    return nil
end

local function toolFireAt(enemy)
