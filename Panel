--=====================================================================
--  CALIBRACIÓN POR FUERZA BRUTA
--=====================================================================
local TEMPLATES = {
    function(t) return packFn(t.char) end,
    function(t) return packFn(t.hum) end,
    function(t) return packFn(t.root.Position, 100) end,
    function(t) return packFn(t.char, 100) end,
    function(t) return packFn(t.hum, 100) end,
    function(t) return packFn(t.root) end,
}

local function bruteForce()
    if calibrating then return end
    if #ALL == 0 then collect() end
    if #ALL == 0 then toast("No hay remotes"); return end

    calibrating = true
    toast("Probando " .. #ALL .. " remotes...")
    local found = 0
    local maxR = math.min(#ALL, 60)

    for i = 1, maxR do
        local remote = ALL[i]
        local list = getEnemies()
        local target = list[1]
        if not target then break end

        for ti = 1, #TEMPLATES do
            local hp0 = target.hum.Health
            fire(remote, TEMPLATES[ti](target))
            task.wait(0.15)
            if target.hum.Health < hp0 or target.hum.Health <= 0 then
                local args = TEMPLATES[ti](target)
                learned = { remote = remote, args = args, score = 99 }
                found += 1
                toast("✔ " .. remote.Name .. " (plantilla " .. ti .. ")")
                break
            end
        end
        if found > 0 then break end
    end

    calibrating = false
    if found == 0 then toast("Nada funcionó · usa arma o revisa VOLCAR")
end

