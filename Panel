local function clearESP()
    for _, h in pairs(Highlights) do pcall(function() h:Destroy() end) end
    Highlights = {}
end

local function refreshESP()
    if not State.esp and not State.names then clearESP(); return end
    local alive = {}
    for _, e in ipairs(getEnemies()) do
        alive[e.char] = true
        if State.esp and (not Highlights[e.char] or not Highlights[e.char].Parent) then
            local h = Instance.new("Highlight")
            h.FillColor = THEME.accent2; h.FillTransparency = 0.6
            h.OutlineColor = THEME.accent
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = e.char; h.Parent = e.char
            Highlights[e.char] = h
        end
    end
    for c, h in pairs(Highlights) do
        if not alive[c] and h:IsA("Highlight") then
            pcall(function() h:Destroy() end); Highlights[c] = nil
        end
    end
end

pcall(function()
    RunService:BindToRenderStep("NMODS_AIM", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not State.aimbot then return end
        local cam = workspace.CurrentCamera
        local best, bestD = nil, math.huge
        local center = cam.ViewportSize / 2
        for _, e in ipairs(getEnemies()) do
            local sp, on = cam:WorldToViewportPoint(e.root.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < bestD then bestD = d; best = e end
            end
        end
        if best then
            cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, best.root.Position), math.clamp(dt*10,0,1))
        end
    end)
end)

